---
import Clock from "@/components/ui/Clock.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import T from "@/components/ui/T.astro";
import { routes, getSiteName, author, services, authorTimezone, authorTimezoneLabel } from "@/lib/constants";
import { getData } from "@/lib/data";
import badges from "@/content/data/badges.json";
import MoodCat from "@/components/home/MoodCat.astro";
import NowSection from "@/components/home/NowSection.astro";
import RecentPosts from "@/components/home/RecentPosts.astro";
import { localePath } from "@/i18n/routing";
import Card from "@/components/ui/Card.astro";

const activeWebringItems = (await getData("webrings")).filter(w => w.status === "active");
const friendSites = badges.filter(badge => badge.category === "friend");

const btn = "w-full sm:w-auto inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors h-11 px-8";

const lang = Astro.locals?.lang || "en";
const resolvedSiteName = getSiteName(lang);
---

<BaseLayout title={resolvedSiteName} isHomePage={true}>
  <div class="relative min-h-screen w-full overflow-hidden">
    <div class="container mx-auto px-2 sm:px-4 lg:px-6 py-8 lg:py-12 relative z-10">
      <div class="max-w-5xl mx-auto">
        <div class="relative pt-6 lg:pt-0 pb-6 mb-6 text-center">
          <T key="home.heading" tag="h1" class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4" />
          <T key="home.subheading" tag="p" class="text-lg md:xl text-muted-foreground mb-8" />
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={localePath(lang, routes.contact)} class:list={[btn, "bg-primary text-primary-foreground hover:bg-primary/90"]}><T key="home.contactButton" /></a>
            <a href={localePath(lang, routes.about)} class:list={[btn, "border border-input bg-background hover:bg-accent hover:text-accent-foreground"]}><T key="home.aboutButton" /></a>
            <a href={localePath(lang, routes.blog)} class:list={[btn, "border border-input bg-background hover:bg-accent hover:text-accent-foreground"]}><T key="home.blogButton" /></a>
            <a href={localePath(lang, routes.guestbook)} class:list={[btn, "border border-input bg-background hover:bg-accent hover:text-accent-foreground"]}><T key="home.guestbookButton" /></a>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-[1.75fr_1fr_1.75fr] gap-4 min-h-32">
          <Card as="section" padding="sm" aria-labelledby="status-cafe-heading">
            <T key="home.currentStatus" tag="h2" id="status-cafe-heading" class="text-lg font-bold mb-3 text-center" />
            <div class="text-center">
              <div id="statuscafe" class="text-sm">
                <a id="status-author" href={services.statusCafe.profileUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">@{author.statusCafeUsername}</a>
                <span id="status-meta"></span>
                <p id="status-content"></p>
              </div>
            </div>
          </Card>

          <Card as="section" padding="sm" aria-labelledby="current-mood-heading">
            <T key="home.currentMood" tag="h2" id="current-mood-heading" class="text-lg font-bold mb-3 text-center" />
            <div class="text-center flex items-center justify-center">
              <a href={services.iMood.profileUrl} target="_blank" rel="noopener noreferrer">
                <img src={services.iMood.widgetUrl} alt="Current mood" class="inline-block pixelated h-[25px] w-auto" loading="lazy" decoding="async" />
              </a>
            </div>
          </Card>

          <Card as="section" padding="sm" aria-labelledby="timezone-heading">
            <T key="home.time" tag="h2" id="timezone-heading" class="text-lg font-bold mb-3 text-center" />
            <div class="flex items-center justify-center gap-6">
              <div class="text-center">
                <Clock id="user-time" class="text-xl font-bold" />
                <p class="text-xs text-muted-foreground mt-1"><T key="home.yourTime" /></p>
              </div>
              <div class="text-center">
                <Clock id="author-time" class="text-xl font-bold" timezone={authorTimezone} />
                <p class="text-xs text-muted-foreground mt-1"><T key="home.myTime" /> ({authorTimezoneLabel})</p>
              </div>
            </div>
          </Card>
        </div>

        <div class="mt-10 lg:mt-12 grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
          <NowSection />
          <MoodCat isHomepage={true} />
        </div>

        <div class="mt-10 lg:mt-12">
          <RecentPosts />
        </div>

        <section class="mt-10 lg:mt-12" aria-labelledby="webrings-heading">
          <h2 id="webrings-heading" class="text-2xl font-bold mb-4 text-center">
            <a href={localePath(lang, routes.webring)} class="no-underline hover:underline focus:underline text-inherit"><T key="webrings.title" /></a>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {activeWebringItems.map((ring) => (
              <Card as="div" padding="none" class="p-3">
                <nav class="flex items-center justify-between gap-1 text-sm" aria-label={`Navigate ${ring.name}`}>
                  <a href={ring.previous} class="text-primary hover:text-primary/80 transition-colors px-1" aria-label={`Previous site in ${ring.name}`}>←</a>
                  <a href={ring.url} class="text-primary hover:underline font-medium mx-2 truncate flex-1 text-center" target="_blank" rel="noopener noreferrer">{ring.name}</a>
                  {ring.random && <a href={ring.random} class="text-primary hover:text-primary/80 transition-colors px-1" aria-label={`Random site in ${ring.name}`}>🎲</a>}
                  <a href={ring.next} class="text-primary hover:text-primary/80 transition-colors px-1" aria-label={`Next site in ${ring.name}`}>→</a>
                </nav>
              </Card>
            ))}
          </div>
          <div class="mt-4 text-center">
            <a href={localePath(lang, routes.webring)} class="inline-flex items-center gap-2 px-3 py-1.5 text-sm border rounded-lg hover:bg-accent transition-colors">
              <T key="home.viewAllWebrings" /> →
            </a>
          </div>
        </section>

        <section class="mt-10 lg:mt-12" aria-labelledby="check-out-heading">
          <T key="home.checkOutSites" tag="h2" id="check-out-heading" class="text-2xl font-bold mb-4 text-center" />
          {friendSites.length > 0 ? (
            <Card as="div" padding="sm" class="flex flex-wrap justify-center gap-2" hover={false}>
              {friendSites.map(({ src, alt, url }) => {
                const img = <img src={src} alt={alt} width={100} height={38} loading="lazy" decoding="async" class="transition-all duration-200 hover:brightness-110 hover:-translate-y-1" />;
                return url ? <a href={url} target="_blank" rel="noopener noreferrer" class="transition-transform duration-200">{img}</a> : img;
              })}
            </Card>
          ) : (
            <Card as="p" class="text-center text-sm text-muted-foreground" hover={false}>Nothing here yet :p</Card>
          )}
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { services } from "@/lib/constants";

  async function loadStatus() {
    if (/(^|\.)neocities\.org$/.test(location.hostname)) return;
    const content = document.getElementById("status-content")!;
    try {
      const response = await fetch(`${services.statusCafe.profileUrl}/status.json`, { signal: AbortSignal.timeout(5000) });
      if (!response.ok) throw new Error("Status unavailable");
      const status = await response.json();
      if (typeof status.content !== "string" || !status.content) return;
      document.getElementById("status-author")!.textContent = `@${status.author}`;
      document.getElementById("status-meta")!.textContent = [status.face, status.timeAgo].filter(Boolean).map(v => ` · ${v}`).join("");
      content.textContent = status.content;
    } catch {
      content.textContent = "Couldn't load status.";
    }
  }

  loadStatus();
</script>
