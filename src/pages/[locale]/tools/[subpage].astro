---
import { locales } from "@/i18n/routing";

export function getStaticPaths() {
  const tools = import.meta.glob("../../tools/*/index.astro");
  return Object.keys(tools).flatMap(path => locales.map(locale => ({
    params: { locale, subpage: path.split("/").at(-2)! },
  })));
}

const views = import.meta.glob<{ default: typeof import("../../tools/index.astro").default }>("../../tools/*/index.astro");
const { default: View } = await views[`../../tools/${Astro.params.subpage}/index.astro`]();
---

<View />
