---
// Catch-all locale page
import { locales } from "@/i18n/routing";
import { localePages } from "@/lib/constants";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    localePages.map((page) => ({ params: { locale, page } }))
  );
}

const views = import.meta.glob<{ default: typeof import("../index.astro").default }>("../*/index.astro");
const { default: View } = await views[`../${Astro.params.page}/index.astro`]();
---

<View />
