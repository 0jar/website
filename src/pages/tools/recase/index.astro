---
import BaseLayout from "@/layouts/BaseLayout.astro";
import T from "@/components/ui/T.astro";
import { t } from "@/i18n";

const lang = Astro.locals?.lang || "en";
const tl = (key: string) => t(lang, `recase.${key}`);
---

<BaseLayout title={tl("title")} description={tl("description")}>
  <div class="container mx-auto px-4 py-8 lg:py-12">
    <div class="max-w-3xl mx-auto">
      <header class="mb-8">
        <T key="recase.title" tag="h1" class="text-4xl font-bold mb-4" />
        <T key="recase.description" tag="p" class="text-muted-foreground text-lg" />
      </header>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <!-- Mode Select -->
        <div class="space-y-2">
          <label for="mode" class="block text-sm font-medium"><T key="recase.mode" /></label>
          <select id="mode" class="w-full h-10 px-3 py-2 rounded-md border border-input bg-background text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
            <option value="casing">{tl("modes.casing")}</option>
            <option value="encode">{tl("modes.encode")}</option>
            <option value="decode">{tl("modes.decode")}</option>
            <option value="hash">{tl("modes.hash")}</option>
          </select>
        </div>
        
        <!-- Operation Select -->
        <div class="space-y-2">
          <label for="operation" class="block text-sm font-medium opacity-0" aria-hidden="true">Operation</label>
          <select id="operation" class="w-full h-10 px-3 py-2 rounded-md border border-input bg-background text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
            <!-- Populated via JS -->
          </select>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Input -->
        <div class="space-y-2 flex flex-col">
          <label for="input-text" class="block text-sm font-medium mb-1"><T key="recase.input" /></label>
          <textarea id="input-text" rows="12" class="w-full flex-grow p-3 rounded-md border border-input bg-background text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 resize-y" placeholder="..."></textarea>
        </div>
        
        <!-- Output -->
        <div class="space-y-2 flex flex-col">
          <div class="flex items-center justify-between mb-1">
            <label for="output-text" class="block text-sm font-medium"><T key="recase.output" /></label>
            <button id="copy-btn" type="button" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-accent hover:text-accent-foreground h-8 px-3 py-1 bg-secondary text-secondary-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mr-2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span id="copy-text"><T key="recase.copy" /></span>
            </button>
          </div>
          <textarea id="output-text" rows="12" readonly class="w-full flex-grow p-3 rounded-md border border-input bg-muted text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 resize-y"></textarea>
          <p id="error-msg" class="text-xs text-destructive mt-1 hidden"></p>
        </div>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script id="recase-options" type="application/json" set:html={JSON.stringify({
  casing: [
    { id: 'reverse', name: tl("casing.reverse") },
    { id: 'upper', name: tl("casing.upper") },
    { id: 'lower', name: tl("casing.lower") },
    { id: 'title', name: tl("casing.title") },
    { id: 'camel', name: tl("casing.camel") },
    { id: 'pascal', name: tl("casing.pascal") },
    { id: 'snake', name: tl("casing.snake") },
    { id: 'screaming_snake', name: tl("casing.screamingSnake") },
    { id: 'kebab', name: tl("casing.kebab") }
  ],
  encode: [
    { id: 'b64', name: tl("encoding.b64") },
    { id: 'url', name: tl("encoding.url") },
    { id: 'html', name: tl("encoding.html") },
    { id: 'hex', name: tl("encoding.hex") },
    { id: 'bin', name: tl("encoding.bin") }
  ],
  decode: [
    { id: 'b64', name: tl("encoding.b64") },
    { id: 'url', name: tl("encoding.url") },
    { id: 'html', name: tl("encoding.html") },
    { id: 'hex', name: tl("encoding.hex") },
    { id: 'bin', name: tl("encoding.bin") }
  ],
  hash: [
    { id: 'md5', name: tl("hashing.md5") },
    { id: 'sha-1', name: tl("hashing.sha1") },
    { id: 'sha-256', name: tl("hashing.sha256") },
    { id: 'sha-512', name: tl("hashing.sha512") }
  ],
  copy: tl("copy"),
  copied: tl("copied")
})}></script>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  
  const modeSelect = $<HTMLSelectElement>("mode");
  const operationSelect = $<HTMLSelectElement>("operation");
  const inputText = $<HTMLTextAreaElement>("input-text");
  const outputText = $<HTMLTextAreaElement>("output-text");
  const copyBtn = $<HTMLButtonElement>("copy-btn");
  const copyText = $<HTMLSpanElement>("copy-text");
  const errorMsg = $<HTMLParagraphElement>("error-msg");
  
  const optionsData = JSON.parse($<HTMLScriptElement>("recase-options").textContent || "{}");
  
  function updateOperations() {
    const mode = modeSelect.value;
    const ops = optionsData[mode] || [];
    operationSelect.innerHTML = "";
    ops.forEach((op: { id: string, name: string }) => {
      const option = document.createElement("option");
      option.value = op.id;
      option.textContent = op.name;
      operationSelect.appendChild(option);
    });
    processText();
  }
  
  function getWords(text: string): string[] {
    let t = text.replace(/[^a-zA-Z0-9]/g, ' ');
    t = t.replace(/([a-z])([A-Z])/g, '$1 $2');
    t = t.replace(/([A-Z])([A-Z][a-z])/g, '$1 $2');
    return t.trim().split(/\s+/).filter(Boolean);
  }

  function utf8Encode(string: string) {
    string = string.replace(/\r\n/g, "\n");
    let utftext = "";
    for (let n = 0; n < string.length; n++) {
      let c = string.charCodeAt(n);
      if (c < 128) {
        utftext += String.fromCharCode(c);
      }
      else if ((c > 127) && (c < 2048)) {
        utftext += String.fromCharCode((c >> 6) | 192);
        utftext += String.fromCharCode((c & 63) | 128);
      }
      else {
        utftext += String.fromCharCode((c >> 12) | 224);
        utftext += String.fromCharCode(((c >> 6) & 63) | 128);
        utftext += String.fromCharCode((c & 63) | 128);
      }
    }
    return utftext;
  }
  
  // A compact MD5 implementation without external dependencies
  function md5(string: string) {
    function rotateLeft(lValue: number, iShiftBits: number) {
      return (lValue << iShiftBits) | (lValue >>> (32 - iShiftBits));
    }
    function addUnsigned(lX: number, lY: number) {
      let lX4, lY4, lX8, lY8, lResult;
      lX8 = (lX & 0x80000000); lY8 = (lY & 0x80000000);
      lX4 = (lX & 0x40000000); lY4 = (lY & 0x40000000);
      lResult = (lX & 0x3FFFFFFF) + (lY & 0x3FFFFFFF);
      if (lX4 & lY4) return (lResult ^ 0x80000000 ^ lX8 ^ lY8);
      if (lX4 | lY4) {
        if (lResult & 0x40000000) return (lResult ^ 0xC0000000 ^ lX8 ^ lY8);
        else return (lResult ^ 0x40000000 ^ lX8 ^ lY8);
      }
      else return (lResult ^ lX8 ^ lY8);
    }
    function F(x: number, y: number, z: number) { return (x & y) | ((~x) & z); }
    function G(x: number, y: number, z: number) { return (x & z) | (y & (~z)); }
    function H(x: number, y: number, z: number) { return (x ^ y ^ z); }
    function I(x: number, y: number, z: number) { return (y ^ (x | (~z))); }
    function FF(a: number, b: number, c: number, d: number, x: number, s: number, ac: number) {
      a = addUnsigned(a, addUnsigned(addUnsigned(F(b, c, d), x), ac));
      return addUnsigned(rotateLeft(a, s), b);
    }
    function GG(a: number, b: number, c: number, d: number, x: number, s: number, ac: number) {
      a = addUnsigned(a, addUnsigned(addUnsigned(G(b, c, d), x), ac));
      return addUnsigned(rotateLeft(a, s), b);
    }
    function HH(a: number, b: number, c: number, d: number, x: number, s: number, ac: number) {
      a = addUnsigned(a, addUnsigned(addUnsigned(H(b, c, d), x), ac));
      return addUnsigned(rotateLeft(a, s), b);
    }
    function II(a: number, b: number, c: number, d: number, x: number, s: number, ac: number) {
      a = addUnsigned(a, addUnsigned(addUnsigned(I(b, c, d), x), ac));
      return addUnsigned(rotateLeft(a, s), b);
    }
    function convertToWordArray(str: string) {
      let lWordCount;
      let lMessageLength = str.length;
      let lNumberOfWords_temp1 = lMessageLength + 8;
      let lNumberOfWords_temp2 = (lNumberOfWords_temp1 - (lNumberOfWords_temp1 % 64)) / 64;
      let lNumberOfWords = (lNumberOfWords_temp2 + 1) * 16;
      let lWordArray = Array(lNumberOfWords - 1);
      let lBytePosition = 0;
      let lByteCount = 0;
      while (lByteCount < lMessageLength) {
        lWordCount = (lByteCount - (lByteCount % 4)) / 4;
        lBytePosition = (lByteCount % 4) * 8;
        lWordArray[lWordCount] = (lWordArray[lWordCount] | (str.charCodeAt(lByteCount) << lBytePosition));
        lByteCount++;
      }
      lWordCount = (lByteCount - (lByteCount % 4)) / 4;
      lBytePosition = (lByteCount % 4) * 8;
      lWordArray[lWordCount] = lWordArray[lWordCount] | (0x80 << lBytePosition);
      lWordArray[lNumberOfWords - 2] = lMessageLength << 3;
      lWordArray[lNumberOfWords - 1] = lMessageLength >>> 29;
      return lWordArray;
    }
    function wordToHex(lValue: number) {
      let WordToHexValue = "", WordToHexValue_temp = "", lByte, lCount;
      for (lCount = 0; lCount <= 3; lCount++) {
        lByte = (lValue >>> (lCount * 8)) & 255;
        WordToHexValue_temp = "0" + lByte.toString(16);
        WordToHexValue = WordToHexValue + WordToHexValue_temp.substr(WordToHexValue_temp.length - 2, 2);
      }
      return WordToHexValue;
    }
    
    let x = Array();
    let k, AA, BB, CC, DD, a, b, c, d;
    let S11=7, S12=12, S13=17, S14=22;
    let S21=5, S22=9, S23=14, S24=20;
    let S31=4, S32=11, S33=16, S34=23;
    let S41=6, S42=10, S43=15, S44=21;
    string = utf8Encode(string);
    x = convertToWordArray(string);
    a = 0x67452301; b = 0xEFCDAB89; c = 0x98BADCFE; d = 0x10325476;
    for (k = 0; k < x.length; k += 16) {
      AA = a; BB = b; CC = c; DD = d;
      a = FF(a, b, c, d, x[k+0],  S11, 0xD76AA478); d = FF(d, a, b, c, x[k+1],  S12, 0xE8C7B756);
      c = FF(c, d, a, b, x[k+2],  S13, 0x242070DB); b = FF(b, c, d, a, x[k+3],  S14, 0xC1BDCEEE);
      a = FF(a, b, c, d, x[k+4],  S11, 0xF57C0FAF); d = FF(d, a, b, c, x[k+5],  S12, 0x4787C62A);
      c = FF(c, d, a, b, x[k+6],  S13, 0xA8304613); b = FF(b, c, d, a, x[k+7],  S14, 0xFD469501);
      a = FF(a, b, c, d, x[k+8],  S11, 0x698098D8); d = FF(d, a, b, c, x[k+9],  S12, 0x8B44F7AF);
      c = FF(c, d, a, b, x[k+10], S13, 0xFFFF5BB1); b = FF(b, c, d, a, x[k+11], S14, 0x895CD7BE);
      a = FF(a, b, c, d, x[k+12], S11, 0x6B901122); d = FF(d, a, b, c, x[k+13], S12, 0xFD987193);
      c = FF(c, d, a, b, x[k+14], S13, 0xA679438E); b = FF(b, c, d, a, x[k+15], S14, 0x49B40821);
      a = GG(a, b, c, d, x[k+1],  S21, 0xF61E2562); d = GG(d, a, b, c, x[k+6],  S22, 0xC040B340);
      c = GG(c, d, a, b, x[k+11], S23, 0x265E5A51); b = GG(b, c, d, a, x[k+0],  S24, 0xE9B6C7AA);
      a = GG(a, b, c, d, x[k+5],  S21, 0xD62F105D); d = GG(d, a, b, c, x[k+10], S22, 0x02441453);
      c = GG(c, d, a, b, x[k+15], S23, 0xD8A1E681); b = GG(b, c, d, a, x[k+4],  S24, 0xE7D3FBC8);
      a = GG(a, b, c, d, x[k+9],  S21, 0x21E1CDE6); d = GG(d, a, b, c, x[k+14], S22, 0xC33707D6);
      c = GG(c, d, a, b, x[k+3],  S23, 0xF4D50D87); b = GG(b, c, d, a, x[k+8],  S24, 0x455A14ED);
      a = GG(a, b, c, d, x[k+13], S21, 0xA9E3E905); d = GG(d, a, b, c, x[k+2],  S22, 0xFCEFA3F8);
      c = GG(c, d, a, b, x[k+7],  S23, 0x676F02D9); b = GG(b, c, d, a, x[k+12], S24, 0x8D2A4C8A);
      a = HH(a, b, c, d, x[k+5],  S31, 0xFFFA3942); d = HH(d, a, b, c, x[k+8],  S32, 0x8771F681);
      c = HH(c, d, a, b, x[k+11], S33, 0x6D9D6122); b = HH(b, c, d, a, x[k+14], S34, 0xFDE5380C);
      a = HH(a, b, c, d, x[k+1],  S31, 0xA4BEEA44); d = HH(d, a, b, c, x[k+4],  S32, 0x4BDECFA9);
      c = HH(c, d, a, b, x[k+7],  S33, 0xF6BB4B60); b = HH(b, c, d, a, x[k+10], S34, 0xBEBFBC70);
      a = HH(a, b, c, d, x[k+13], S31, 0x289B7EC6); d = HH(d, a, b, c, x[k+0],  S32, 0xEAA127FA);
      c = HH(c, d, a, b, x[k+3],  S33, 0xD4EF3085); b = HH(b, c, d, a, x[k+6],  S34, 0x04881D05);
      a = HH(a, b, c, d, x[k+9],  S31, 0xD9D4D039); d = HH(d, a, b, c, x[k+12], S32, 0xE6DB99E5);
      c = HH(c, d, a, b, x[k+15], S33, 0x1FA27CF8); b = HH(b, c, d, a, x[k+2],  S34, 0xC4AC5665);
      a = II(a, b, c, d, x[k+0],  S41, 0xF4292244); d = II(d, a, b, c, x[k+7],  S42, 0x432AFF97);
      c = II(c, d, a, b, x[k+14], S43, 0xAB9423A7); b = II(b, c, d, a, x[k+5],  S44, 0xFC93A039);
      a = II(a, b, c, d, x[k+12], S41, 0x655B59C3); d = II(d, a, b, c, x[k+3],  S42, 0x8F0CCC92);
      c = II(c, d, a, b, x[k+10], S43, 0xFFEFF47D); b = II(b, c, d, a, x[k+1],  S44, 0x85845DD1);
      a = II(a, b, c, d, x[k+8],  S41, 0x6FA87E4F); d = II(d, a, b, c, x[k+15], S42, 0xFE2CE6E0);
      c = II(c, d, a, b, x[k+6],  S43, 0xA3014314); b = II(b, c, d, a, x[k+13], S44, 0x4E0811A1);
      a = II(a, b, c, d, x[k+4],  S41, 0xF7537E82); d = II(d, a, b, c, x[k+11], S42, 0xBD3AF235);
      c = II(c, d, a, b, x[k+2],  S43, 0x2AD7D2BB); b = II(b, c, d, a, x[k+9],  S44, 0xEB86D391);
      a = addUnsigned(a, AA); b = addUnsigned(b, BB); c = addUnsigned(c, CC); d = addUnsigned(d, DD);
    }
    let temp = wordToHex(a) + wordToHex(b) + wordToHex(c) + wordToHex(d);
    return temp.toLowerCase();
  }

  async function processText() {
    const text = inputText.value;
    const mode = modeSelect.value;
    const op = operationSelect.value;
    
    errorMsg.classList.add("hidden");
    
    if (!text) {
      outputText.value = "";
      return;
    }
    
    try {
      let result = "";
      
      if (mode === "casing") {
        if (op === "reverse") result = text.split('').reverse().join('');
        else if (op === "upper") result = text.toUpperCase();
        else if (op === "lower") result = text.toLowerCase();
        else if (op === "title") {
          result = text.toLowerCase().replace(/(?:^|[^a-z0-9])([a-z])/g, (m, c) => m.toUpperCase());
        } else {
          const w = getWords(text);
          if (w.length === 0) {
            result = "";
          } else if (op === "camel") {
            result = w[0].toLowerCase() + w.slice(1).map(x => x.charAt(0).toUpperCase() + x.slice(1).toLowerCase()).join('');
          } else if (op === "pascal") {
            result = w.map(x => x.charAt(0).toUpperCase() + x.slice(1).toLowerCase()).join('');
          } else if (op === "snake") {
            result = w.map(x => x.toLowerCase()).join('_');
          } else if (op === "screaming_snake") {
            result = w.map(x => x.toUpperCase()).join('_');
          } else if (op === "kebab") {
            result = w.map(x => x.toLowerCase()).join('-');
          }
        }
      } 
      else if (mode === "encode") {
        if (op === "b64") result = btoa(utf8Encode(text)); // support unicode
        else if (op === "url") result = encodeURIComponent(text);
        else if (op === "html") {
          result = text.replace(/[&<>"']/g, (m) => {
            const map: Record<string, string> = {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'};
            return map[m] || m;
          });
        }
        else if (op === "hex") {
          result = Array.from(new TextEncoder().encode(text)).map(b => b.toString(16).padStart(2, '0')).join('');
        }
        else if (op === "bin") {
          result = Array.from(new TextEncoder().encode(text)).map(b => b.toString(2).padStart(8, '0')).join(' ');
        }
      }
      else if (mode === "decode") {
        if (op === "b64") {
          // manually decode utf-8 after atob
          const binary = atob(text);
          const bytes = new Uint8Array(binary.length);
          for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
          result = new TextDecoder().decode(bytes);
        }
        else if (op === "url") result = decodeURIComponent(text);
        else if (op === "html") {
          const doc = new DOMParser().parseFromString(text, "text/html");
          result = doc.documentElement.textContent || "";
        }
        else if (op === "hex") {
          const cleaned = text.replace(/\s+/g, '');
          if (cleaned.length % 2 !== 0) throw new Error("Invalid hex string length");
          const matches = cleaned.match(/.{1,2}/g) || [];
          result = new TextDecoder().decode(new Uint8Array(matches.map(byte => parseInt(byte, 16))));
        }
        else if (op === "bin") {
          const tokens = text.trim().split(/\s+/);
          result = new TextDecoder().decode(new Uint8Array(tokens.map(bin => parseInt(bin, 2))));
        }
      }
      else if (mode === "hash") {
        if (op === "md5") {
          result = md5(text);
        } else {
          const encoder = new TextEncoder();
          const data = encoder.encode(text);
          let algo = "SHA-256";
          if (op === "sha-1") algo = "SHA-1";
          if (op === "sha-512") algo = "SHA-512";
          
          const hashBuffer = await crypto.subtle.digest(algo, data);
          const hashArray = Array.from(new Uint8Array(hashBuffer));
          result = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        }
      }
      
      outputText.value = result;
    } catch (e: any) {
      outputText.value = "";
      errorMsg.textContent = e.message || "An error occurred";
      errorMsg.classList.remove("hidden");
    }
  }

  modeSelect.addEventListener("change", updateOperations);
  operationSelect.addEventListener("change", processText);
  inputText.addEventListener("input", processText);

  copyBtn.addEventListener("click", () => {
    if (!outputText.value) return;
    navigator.clipboard.writeText(outputText.value).then(() => {
      const orig = copyText.textContent;
      copyText.textContent = optionsData.copied;
      setTimeout(() => { copyText.textContent = orig; }, 2000);
    });
  });
  
  // Initialize
  updateOperations();
</script>
