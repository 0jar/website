---
import BaseLayout from "@/layouts/BaseLayout.astro";
import T from "@/components/ui/T.astro";
import { t } from "@/i18n";

const lang = Astro.locals?.lang || "en";
const tl = (key: string) => t(lang, `recase.${key}`);
---

<BaseLayout title={tl("title")} description={tl("description")}>
  <div class="container mx-auto px-4 py-8 lg:py-12">
    <div class="max-w-3xl mx-auto">
      <header class="mb-8">
        <T key="recase.title" tag="h1" class="text-4xl font-bold mb-4" />
        <T key="recase.description" tag="p" class="text-muted-foreground text-lg" />
      </header>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <!-- Mode Select -->
        <div class="space-y-2">
          <label for="mode" class="block text-sm font-medium"><T key="recase.mode" /></label>
          <select id="mode" class="w-full h-10 px-3 py-2 rounded-md border border-input bg-background text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
            <option value="casing">{tl("modes.casing")}</option>
            <option value="encode">{tl("modes.encode")}</option>
            <option value="decode">{tl("modes.decode")}</option>
            <option value="hash">{tl("modes.hash")}</option>
          </select>
        </div>
        
        <!-- Operation Select -->
        <div>
          <label for="operation" class="block text-sm font-medium text-transparent select-none pointer-events-none mb-2" aria-hidden="true">Operation</label>
          <select id="operation" aria-label="Operation" class="w-full h-10 px-3 py-2 rounded-md border border-input bg-background text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
            <!-- Populated via JS -->
          </select>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Input -->
        <div class="space-y-2 flex flex-col">
          <div class="flex items-center h-8 mb-1">
            <label for="input-text" class="block text-sm font-medium"><T key="recase.input" /></label>
          </div>
          <textarea id="input-text" rows="12" class="w-full flex-grow p-3 rounded-md border border-input bg-background text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 resize-y" placeholder="..."></textarea>
        </div>
        
        <!-- Output -->
        <div class="space-y-2 flex flex-col">
          <div class="flex items-center justify-between h-8 mb-1">
            <label for="output-text" class="block text-sm font-medium"><T key="recase.output" /></label>
            <button id="copy-btn" type="button" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 hover:bg-accent hover:text-accent-foreground h-8 px-3 py-1 bg-secondary text-secondary-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mr-2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span id="copy-text"><T key="recase.copy" /></span>
            </button>
          </div>
          <textarea id="output-text" rows="12" readonly class="w-full flex-grow p-3 rounded-md border border-input bg-muted text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 resize-y"></textarea>
          <p id="error-msg" class="text-xs text-destructive mt-1 hidden"></p>
        </div>
      </div>
      
    </div>
  </div>
</BaseLayout>

<script id="recase-options" type="application/json" set:html={JSON.stringify({
  casing: [
    { id: 'reverse', name: tl("casing.reverse") },
    { id: 'upper', name: tl("casing.upper") },
    { id: 'lower', name: tl("casing.lower") },
    { id: 'title', name: tl("casing.title") },
    { id: 'camel', name: tl("casing.camel") },
    { id: 'pascal', name: tl("casing.pascal") },
    { id: 'snake', name: tl("casing.snake") },
    { id: 'screaming_snake', name: tl("casing.screamingSnake") },
    { id: 'kebab', name: tl("casing.kebab") }
  ],
  encode: [
    { id: 'b64', name: tl("encoding.b64") },
    { id: 'url', name: tl("encoding.url") },
    { id: 'html', name: tl("encoding.html") },
    { id: 'hex', name: tl("encoding.hex") },
    { id: 'bin', name: tl("encoding.bin") }
  ],
  decode: [
    { id: 'b64', name: tl("encoding.b64") },
    { id: 'url', name: tl("encoding.url") },
    { id: 'html', name: tl("encoding.html") },
    { id: 'hex', name: tl("encoding.hex") },
    { id: 'bin', name: tl("encoding.bin") }
  ],
  hash: [
    { id: 'md5', name: tl("hashing.md5") },
    { id: 'sha-1', name: tl("hashing.sha1") },
    { id: 'sha-256', name: tl("hashing.sha256") },
    { id: 'sha-512', name: tl("hashing.sha512") }
  ],
  copy: tl("copy"),
  copied: tl("copied")
})}></script>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  
  const modeSelect = $<HTMLSelectElement>("mode");
  const operationSelect = $<HTMLSelectElement>("operation");
  const inputText = $<HTMLTextAreaElement>("input-text");
  const outputText = $<HTMLTextAreaElement>("output-text");
  const copyBtn = $<HTMLButtonElement>("copy-btn");
  const copyText = $<HTMLSpanElement>("copy-text");
  const errorMsg = $<HTMLParagraphElement>("error-msg");
  
  const optionsData = JSON.parse($<HTMLScriptElement>("recase-options").textContent || "{}");
  
  function updateOperations() {
    operationSelect.innerHTML = "";
    (optionsData[modeSelect.value] || []).forEach((op: { id: string, name: string }) => {
      const option = document.createElement("option");
      option.value = op.id;
      option.textContent = op.name;
      operationSelect.appendChild(option);
    });
    processText();
  }
  
  function getWords(text: string): string[] {
    return text.replace(/[^a-zA-Z0-9]/g, ' ')
               .replace(/([a-z])([A-Z])/g, '$1 $2')
               .replace(/([A-Z])([A-Z][a-z])/g, '$1 $2')
               .trim().split(/\s+/).filter(Boolean);
  }

  function md5(str: string) {
    let hash = [1732584193, -271733879, -1732584194, 271733878];
    let bytes = Array.from(new TextEncoder().encode(str));
    let l = bytes.length * 8;
    bytes.push(128);
    while ((bytes.length * 8) % 512 !== 448) bytes.push(0);
    for (let i = 0; i < 8; i++) bytes.push((l >>> (i * 8)) & 0xff);
    
    let w = new Int32Array(16);
    for (let i = 0; i < bytes.length; i += 64) {
      for (let j = 0; j < 16; j++) {
        w[j] = bytes[i + j * 4] | (bytes[i + j * 4 + 1] << 8) | (bytes[i + j * 4 + 2] << 16) | (bytes[i + j * 4 + 3] << 24);
      }
      let [a, b, c, d] = hash;
      for (let j = 0; j < 64; j++) {
        let f, k;
        if (j < 16) { f = (b & c) | (~b & d); k = j; }
        else if (j < 32) { f = (d & b) | (~d & c); k = (5 * j + 1) % 16; }
        else if (j < 48) { f = b ^ c ^ d; k = (3 * j + 5) % 16; }
        else { f = c ^ (b | ~d); k = (7 * j) % 16; }
        
        let temp = (a + f + w[k] + Math.trunc(Math.abs(Math.sin(j + 1)) * 4294967296)) | 0;
        let rot = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21][Math.floor(j / 16) * 4 + (j % 4)];
        temp = ((temp << rot) | (temp >>> (32 - rot))) + b;
        a = d; d = c; c = b; b = temp;
      }
      hash[0] = (hash[0] + a) | 0;
      hash[1] = (hash[1] + b) | 0;
      hash[2] = (hash[2] + c) | 0;
      hash[3] = (hash[3] + d) | 0;
    }
    return hash.map(h => Array.from({length: 4}, (_, i) => ((h >>> (i * 8)) & 0xff).toString(16).padStart(2, '0')).join('')).join('');
  }

  async function processText() {
    const text = inputText.value;
    const mode = modeSelect.value;
    const op = operationSelect.value;
    
    errorMsg.classList.add("hidden");
    if (!text) {
      outputText.value = "";
      return;
    }
    
    try {
      let result = "";
      
      if (mode === "casing") {
        const w = getWords(text);
        switch (op) {
          case "reverse": result = text.split('').reverse().join(''); break;
          case "upper": result = text.toUpperCase(); break;
          case "lower": result = text.toLowerCase(); break;
          case "title": result = text.toLowerCase().replace(/(?:^|[^a-z0-9])([a-z])/g, m => m.toUpperCase()); break;
          case "camel": result = w.length ? w[0].toLowerCase() + w.slice(1).map(x => x.charAt(0).toUpperCase() + x.slice(1).toLowerCase()).join('') : ""; break;
          case "pascal": result = w.map(x => x.charAt(0).toUpperCase() + x.slice(1).toLowerCase()).join(''); break;
          case "snake": result = w.map(x => x.toLowerCase()).join('_'); break;
          case "screaming_snake": result = w.map(x => x.toUpperCase()).join('_'); break;
          case "kebab": result = w.map(x => x.toLowerCase()).join('-'); break;
        }
      } 
      else if (mode === "encode") {
        const encoder = new TextEncoder();
        switch (op) {
          case "b64": {
            const bytes = encoder.encode(text);
            let bin = '';
            for (let i = 0; i < bytes.length; i += 8192) {
              bin += String.fromCharCode.apply(null, Array.from(bytes.subarray(i, i + 8192)));
            }
            result = btoa(bin);
            break;
          }
          case "url": result = encodeURIComponent(text); break;
          case "html": 
            result = text.replace(/[&<>"']/g, m => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[m] || m)); 
            break;
          case "hex": result = Array.from(encoder.encode(text)).map(b => b.toString(16).padStart(2, '0')).join(''); break;
          case "bin": result = Array.from(encoder.encode(text)).map(b => b.toString(2).padStart(8, '0')).join(' '); break;
        }
      }
      else if (mode === "decode") {
        const decoder = new TextDecoder();
        switch (op) {
          case "b64": {
            const binary = atob(text);
            const bytes = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
            result = decoder.decode(bytes);
            break;
          }
          case "url": result = decodeURIComponent(text); break;
          case "html": result = new DOMParser().parseFromString(text, "text/html").documentElement.textContent || ""; break;
          case "hex": {
            const cleaned = text.replace(/\s+/g, '');
            if (cleaned.length % 2 !== 0) throw new Error("Invalid hex string length");
            result = decoder.decode(new Uint8Array((cleaned.match(/.{1,2}/g) || []).map(b => parseInt(b, 16))));
            break;
          }
          case "bin": result = decoder.decode(new Uint8Array(text.trim().split(/\s+/).map(b => parseInt(b, 2)))); break;
        }
      }
      else if (mode === "hash") {
        if (op === "md5") {
          result = md5(text);
        } else {
          const hashBuffer = await crypto.subtle.digest(op.toUpperCase(), new TextEncoder().encode(text));
          result = Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
        }
      }
      
      outputText.value = result;
    } catch (e: any) {
      outputText.value = "";
      errorMsg.textContent = e.message || "An error occurred";
      errorMsg.classList.remove("hidden");
    }
  }

  modeSelect.addEventListener("change", updateOperations);
  operationSelect.addEventListener("change", processText);
  inputText.addEventListener("input", processText);

  copyBtn.addEventListener("click", () => {
    if (!outputText.value) return;
    navigator.clipboard.writeText(outputText.value).then(() => {
      const orig = copyText.textContent;
      copyText.textContent = optionsData.copied;
      setTimeout(() => { copyText.textContent = orig; }, 2000);
    });
  });
  
  updateOperations();
</script>
