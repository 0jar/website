---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n";
import T from "@/components/ui/T.astro";
import { getData } from "@/lib/data";
import { usesIcons } from "@/lib/constants";

const usesCategories = await getData("uses");
import platformData from "@/content/uses/hidden.json";

const getIcon = (title: string) => usesIcons[title] || "📌";
const isHiddenPlatform = (name: string) => name.startsWith('Unspeakable');
const getHiddenPlatform = (name: string) => name === 'Unspeakable Platform 1' ? 'revanced' : 'stremio';

const locale = Astro.locals?.lang || Astro.currentLocale || "en";
---

<BaseLayout title="Uses" description="The tools and tech I use daily.">
  <div class="container mx-auto px-4 py-8 lg:py-12">
    <div class="max-w-4xl mx-auto">
      <header class="mb-10 text-center">
        <T key="uses.title" tag="h1" class="text-4xl font-bold mb-4" />
        <p class="text-muted-foreground text-lg mx-auto">
          <T key="uses.description" />
          {" "}
          <a href="https://uses.tech" target="_blank" rel="noopener noreferrer" class="text-primary underline">uses.tech</a>,
          {" "}
          <T key="uses.websiteDescription" />
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        {usesCategories.map((category) => (
          <section id={category.title} class="scroll-mt-20">
            <div class="flex items-center gap-3 mb-6">
              <span class="text-2xl" aria-hidden="true">{getIcon(category.title)}</span>
              <T key={`uses.categories.${category.title}`} tag="h2" class="text-2xl font-bold category-title" />
            </div>

            {category.items.length > 0 && (
              <div class="space-y-4 ml-4">
                {category.items.map((item) => isHiddenPlatform(item.name) ? (
                  <div class="hidden-platform">
                    <button type="button" class="text-left" data-counter={t(locale, "uses.hidden.clicksLeft")}>
                      <span class="text-lg font-medium">🔒 <T key="uses.hidden.platformPrefix" /> {item.name.endsWith("1") ? "1" : "2"}</span>
                      <span class="text-xs text-muted-foreground" aria-live="polite"><T key="uses.hidden.clicksLeft" params={{ clicks: 5 }} /></span>
                      <T key="uses.hidden.clickToReveal" class="block text-muted-foreground" />
                    </button>
                    <div hidden>
                      <a class="text-lg font-medium hover:underline" href={platformData[getHiddenPlatform(item.name)].link} target="_blank" rel="noopener noreferrer">
                        {platformData[getHiddenPlatform(item.name)].name} ↗
                      </a>
                      <p class="text-muted-foreground">{platformData[getHiddenPlatform(item.name)].description}</p>
                    </div>
                  </div>
                ) : (
                  <div class="flex items-start gap-3">
                    <div class="flex-shrink-0 mt-1.5 w-3 h-3 rounded-full bg-primary" />
                    <div class="flex-1">
                      {item.link ? (
                        <a href={item.link} target="_blank" rel="noopener noreferrer" class="text-lg font-medium hover:text-primary flex items-center">
                          {item.name}<span class="text-xs ml-1 opacity-70">↗</span>
                        </a>
                      ) : <h3 class="text-lg font-medium">{item.name}</h3>}
                      {item.description && (
                        <p class="text-muted-foreground item-description">
                          {typeof item.description === 'string' ? item.description : (item.description[locale as keyof typeof item.description] || item.description.en)}
                        </p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".hidden-platform button")) {
    let remaining = 5;
    button.addEventListener("click", () => {
      remaining--;
      if (remaining) {
        button.querySelector("[aria-live]")!.textContent = button.dataset.counter!.replace("{{clicks}}", String(remaining));
        return;
      }
      const details = button.nextElementSibling as HTMLElement;
      details.hidden = false;
      button.hidden = true;
      details.querySelector("a")?.focus();
    });
  }
</script>
