---
import Icon from "@/components/ui/Icon.astro";
import T from "@/components/ui/T.astro";

interface Props {
  isHomepage?: boolean;
}
const { isHomepage = false } = Astro.props;
import { cats } from "@/lib/constants/cats";

const initial = cats[Math.floor(Math.random() * cats.length)];
---

<mood-cat data-current={initial.image} class="flex flex-col h-full group/widget">
  <section aria-labelledby="mood-cat-heading" class="flex flex-col h-full">
    <h2 id="mood-cat-heading" class="text-2xl font-bold mb-4 text-center relative group flex-shrink-0">
      <a href="/now/" class="no-underline hover:underline focus:underline text-inherit">
        <T key="moodCat.title" />
      </a>
      <span class="absolute left-0 -bottom-1 w-full h-1 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span>
      <span class="absolute left-0 -top-6 w-full text-xs text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
        <T key="moodCat.hover" />
      </span>
    </h2>

    <div class="border rounded-lg p-4 bg-card flex flex-col flex-1">
      <figure class={`relative rounded-xl overflow-hidden bg-muted flex-1 m-0 ${isHomepage ? 'min-h-0' : ''}`}>
        <div class={`w-full relative h-[350px] ${isHomepage ? 'lg:absolute lg:inset-0 lg:h-full' : ''}`}>
          <img
            src={initial.image}
            alt={`Mood cat: ${initial.caption}`}
            class="w-full h-full object-cover transition-opacity duration-150 ease-in-out"
            loading="eager"
            width="550"
            height="360"
            data-image
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-4 pt-8 text-center" aria-live="polite">
            <p class="text-white text-base lg:text-lg font-medium" data-caption>{initial.caption}</p>
            <p class={`text-white/80 text-xs mt-1 transition-opacity ${!initial.url ? 'hidden' : ''}`} data-attr>
              <a href={initial.url || "#"} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors focus-visible:outline-white">
                Image source
              </a>
            </p>
          </figcaption>
        </div>
      </figure>

      <div class="mt-4 flex justify-center gap-3">
        <button
          type="button"
          class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium border rounded-lg hover:bg-accent hover:text-accent-foreground transition-colors group focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          aria-label="Get a new cat image"
          data-refresh
        >
          <Icon name="refresh" width="16" height="16" class="group-hover:rotate-180 transition-transform duration-500" />
          <T key="moodCat.refresh" />
        </button>
        <a
          href="https://www.reddit.com/r/Catswithjobs/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium border rounded-lg hover:bg-accent hover:text-accent-foreground transition-colors group focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
        >
          <Icon name="externalLink" width="16" height="16" class="motion-safe:group-hover:animate-pulse" />
          <T key="moodCat.seeMore" />
        </a>
      </div>
    </div>
  </section>
</mood-cat>

<script>
  import { cats } from "@/lib/constants/cats";
  class MoodCat extends HTMLElement {
    connectedCallback() {
      if (cats.length < 2) return;

      let currentImage = this.dataset.current || "";
      const btn = this.querySelector("[data-refresh]");
      const img = this.querySelector("[data-image]") as HTMLImageElement | null;
      const caption = this.querySelector("[data-caption]");
      const attr = this.querySelector("[data-attr]");
      const link = attr?.querySelector("a");

      btn?.addEventListener("click", () => {
        let newCat;
        do { newCat = cats[Math.floor(Math.random() * cats.length)]; } while (newCat.image === currentImage);
        currentImage = newCat.image;

        if (img) img.style.opacity = "0";
        setTimeout(() => {
          if (img) {
            img.src = newCat.image;
            img.alt = `Mood cat: ${newCat.caption}`;
          }
          if (caption) caption.textContent = newCat.caption;
          if (attr && link) {
            attr.classList.toggle("hidden", !newCat.url);
            if (newCat.url) link.href = newCat.url;
          }
          if (img) img.style.opacity = "1";
        }, 150);
      });
    }
  }

  if (!customElements.get("mood-cat")) {
    customElements.define("mood-cat", MoodCat);
  }
</script>
