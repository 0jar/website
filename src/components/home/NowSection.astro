---
import T from "@/components/ui/T.astro";
import NowItems from "./NowItems.astro";
import { getNowItems } from "@/lib/data";
import { localePath } from "@/i18n/routing";

const items = (await getNowItems()).slice(0, 3);
---

<section aria-labelledby="now-heading">
  <h2 id="now-heading" class="text-2xl font-bold mb-4 text-center">
    <a href={localePath(Astro.locals.lang, "/now/")} class="no-underline hover:underline focus:underline text-inherit">
      <T key="home.latestNow" />
    </a>
  </h2>
  <NowItems items={items} compact />
</section>
