---
import Icon from "@/components/ui/Icon.astro";
// Notification banners: incomplete-translation warning + polyglot easter egg
import { supportedLanguages, completedLanguages } from "@/lib/constants";
import T from "@/components/ui/T.astro";
import { t } from "@/i18n";

const lang = Astro.locals?.lang || "en";
const langCount = supportedLanguages.length;
const isComplete = (completedLanguages as readonly string[]).includes(lang);
---

<!-- Language notice -->
{!isComplete && lang !== "en" && (
  <div id="lang-notice" class="fixed top-16 inset-x-0 z-50 flex justify-center p-4">
    <div class="bg-amber-100 dark:bg-amber-900 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-100 px-4 py-3 rounded-lg shadow-md flex items-center max-w-xl">
      <Icon name="info" width="20" height="20" class="mr-3 flex-shrink-0" />
      <T key="languageNotice.message" tag="p" class="text-sm" />
      <button data-dismiss="lang-notice" class="ml-4 p-1 rounded-full hover:bg-amber-200 dark:hover:bg-amber-800 transition-colors" aria-label={t(lang, "languageNotice.dismiss")}>
        <Icon name="close" width="16" height="16" />
      </button>
    </div>
  </div>
)}

<!-- Polyglot easter egg -->
<div id="easter-egg" class="fixed top-16 inset-x-0 z-50 flex justify-center p-4 hidden">
  <div class="bg-purple-100 dark:bg-purple-900 border border-purple-200 dark:border-purple-800 text-purple-800 dark:text-purple-100 px-4 py-3 rounded-lg shadow-md flex items-center max-w-xl">
    <Icon name="wand" width="20" height="20" class="mr-3 flex-shrink-0" />
    <div class="flex flex-col">
      <p class="text-sm font-medium">Achievement Unlocked: Polyglot!</p>
      <p class="text-xs opacity-80">You&apos;ve visited all {langCount} language versions of this site. Impressive!</p>
    </div>
    <button data-dismiss="easter-egg" class="ml-4 p-1 rounded-full hover:bg-purple-200 dark:hover:bg-purple-800 transition-colors" aria-label="Dismiss">
      <Icon name="close" width="16" height="16" />
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    // Dismiss buttons
    document.querySelectorAll("[data-dismiss]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var target = document.getElementById(btn.getAttribute("data-dismiss"));
        if (target) target.classList.add("hidden");
        if (btn.getAttribute("data-dismiss") === "lang-notice") {
          try { localStorage.setItem("languageNoticeDismissed", "true"); } catch (e) {}
        }
      });
    });

    // Hide lang notice if previously dismissed
    var notice = document.getElementById("lang-notice");
    if (notice) {
      try { if (localStorage.getItem("languageNoticeDismissed") === "true") notice.classList.add("hidden"); } catch (e) {}
    }

    // Polyglot easter egg
    var locale = document.documentElement.dataset.locale || "en";
    var allCodes = JSON.parse(document.getElementById("easter-egg")?.closest("[data-lang-codes]")?.dataset.langCodes || "[]");
    try {
      var visited = JSON.parse(localStorage.getItem("language-tracker") || "[]");
      var s = new Set(visited);
      s.add(locale);
      localStorage.setItem("language-tracker", JSON.stringify(Array.from(s)));
      if (allCodes.length > 0 && allCodes.every(function (c) { return s.has(c); })) {
        var egg = document.getElementById("easter-egg");
        if (egg) egg.classList.remove("hidden");
      }
    } catch (e) {}
  })();
</script>
