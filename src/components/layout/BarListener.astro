---
import { t } from "@/i18n";
---

<dialog id="command-dialog" aria-label={t(Astro.locals.lang, "actionSearch.title")}
  class="mx-auto mt-[15vh] w-[min(28rem,calc(100%-2rem))] max-h-[80vh] rounded-lg border bg-background text-foreground shadow-lg backdrop:bg-black/50">
  <div id="command-bar-root"></div>
</dialog>

<script>
  import { routes, keyboardShortcuts } from "@/lib/constants";
  import { cycleTheme } from "@/lib/utils/theme";
  import { cycleLanguage, getPageLocale } from "@/i18n/client";
  import { localePath, stripLocale } from "@/i18n/routing";
  import { editingField } from "@/lib/utils/keyboard";

  const dialog = document.querySelector<HTMLDialogElement>("#command-dialog")!;
  const root = document.getElementById("command-bar-root")!;
  const locale = getPageLocale();
  const path = stripLocale(location.pathname);
  const nav = new Map(Object.entries(routes).map(([key, href]) => [keyboardShortcuts[key], href]));

  async function openPalette() {
    const { mountPalette } = await import("@/components/commands/Bar");
    if (dialog.open) return;
    mountPalette(root, dialog);
    dialog.showModal();
  }

  document.getElementById("footer-command-bar-trigger")?.addEventListener("click", openPalette);
  dialog.addEventListener("click", event => {
    if (event.target === dialog) dialog.close();
  });

  window.addEventListener("keydown", event => {
    if (event.defaultPrevented || event.isComposing || event.repeat || event.altKey || event.ctrlKey || event.metaKey
      || dialog.open || editingField(event.target) || localStorage.getItem("keyboard-shortcuts") === "false") return;
    const key = event.key;
    const game = path === routes.game2048 || path === routes.tetris;
    if (key === ".") openPalette();
    else if (key === "m") cycleTheme();
    else if (key === "y") cycleLanguage();
    else if (key === "r" && !game) document.querySelector<HTMLButtonElement>("mood-cat [data-refresh]")?.click();
    else if (nav.has(key) && (!game || key === "h")) location.href = localePath(locale, nav.get(key)!);
    else return;
    event.preventDefault();
  });
</script>
